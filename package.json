{
  "name": "obsidian-lapel",
  "version": "0.1.6",
  "description": "Dress up your editor with decorations that mark each of your headings.",
  "author": "liamcain",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "lint": "eslint .",
    "dev": "node esbuild.config.mjs",
    "build": "pnpm run lint && node esbuild.config.mjs production",
    "build:local": "node --env-file-if-exists=.env scripts/build-local.mjs",
    "release": "standard-version"
  },
  "standard-version": {
    "t": "",
    "bumpFiles": [
      {
        "filename": "package.json",
        "type": "json"
      },
      {
        "filename": "manifest.json",
        "type": "json"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/language": "https://github.com/lishid/cm-language",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.30.1",
    "@types/node": "^16.11.6",
    "esbuild": "^0.14.45",
    "eslint": "9.30.1",
    "eslint-plugin-obsidianmd": "0.2.9",
    "globals": "14.0.0",
    "jiti": "2.6.1",
    "obsidian": "latest",
    "standard-version": "^9.3.2",
    "tslib": "2.5.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.35.1"
  }
}
